{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
        "graph_id": {
            "type": "string"
        },
        "chat_id": {
            "type": "string"
        },
        "data_schema": {
            "type": "object",
            "properties": {
                "type": {
                    "type": "string"
                },
                "properties": {
                    "type": "object",
                    "additionalProperties": {
                        "type": "object",
                        "properties": {
                            "type": {
                                "type": "string"
                            },
                            "default": {},
                            "required": {
                                "type": "boolean"
                            }
                        },
                        "required": [
                            "type"
                        ]
                    }
                },
                "required": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                }
            },
            "required": [
                "type",
                "properties"
            ]
        },
        "max_parallel": {
            "type": "integer",
            "minimum": 1
        },
        "nodes": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string"
                    },
                    "type": {
                        "enum": [
                            "start",
                            "end",
                            "agent",
                            "function"
                        ]
                    },
                    "function": {
                        "type": "object",
                        "properties": {
                            "function": {
                                "type": "string"
                            },
                            "module": {
                                "type": "string"
                            }
                        },
                        "required": [
                            "function"
                        ]
                    },
                    "is_agent": {
                        "type": "boolean"
                    },
                    "agent_schema": {
                        "type": "object",
                        "properties": {
                            "type": {
                                "type": "string"
                            },
                            "properties": {
                                "type": "object",
                                "additionalProperties": {
                                    "type": "object",
                                    "properties": {
                                        "type": {
                                            "type": "string"
                                        }
                                    },
                                    "required": [
                                        "type"
                                    ]
                                }
                            },
                            "required": {
                                "type": "array",
                                "items": {
                                    "type": "string"
                                }
                            }
                        },
                        "required": [
                            "type",
                            "properties",
                            "required"
                        ]
                    }
                },
                "required": [
                    "id",
                    "type"
                ]
            }
        },
        "edges": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "source": {
                        "type": "string"
                    },
                    "target": {
                        "oneOf": [
                            {
                                "type": "string"
                            },
                            {
                                "type": "object",
                                "properties": {
                                    "graph_id": {
                                        "type": "string"
                                    },
                                    "node_id": {
                                        "type": "string"
                                    }
                                },
                                "required": [
                                    "graph_id",
                                    "node_id"
                                ]
                            }
                        ]
                    },
                    "condition": {
                        "type": "string"
                    },
                    "is_required": {
                        "type": "boolean"
                    }
                },
                "required": [
                    "source",
                    "target"
                ]
            }
        },
        "connected_graphs": {
            "type": "array",
            "items": {
                "type": "string"
            }
        }
    },
    "required": [
        "graph_id",
        "data_schema",
        "nodes",
        "edges"
    ]
}